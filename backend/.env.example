# Kopyalayın: cp .env.example .env  (.env depoya girmez)
ENVIRONMENT=development
# production'da zorunlu, en az 32 karakter: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_URL=sqlite:///./skinsavvy.db
CORS_ORIGINS=https://melisayalcinkaya.github.io,http://localhost:8080
SEED_DEMO=true
# Yönetici hesabı yalnızca bu iki değer verilirse oluşturulur.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Render gibi ters vekil arkasında true
TRUST_FORWARDED_FOR=false
